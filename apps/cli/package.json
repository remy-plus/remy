{
  "name": "@koryei/remy",
  "version": "0.4.1",
  "license": "Apache-2.0",
  "description": "Remy: one calm assistant for real digital work, in your terminal.",
  "homepage": "https://remy.plus",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/remy-plus/remy.git",
    "directory": "apps/cli"
  },
  "bugs": "https://github.com/remy-plus/remy/issues",
  "keywords": [
    "agent",
    "ai",
    "assistant",
    "cli",
    "terminal"
  ],
  "type": "module",
  "engines": {
    "node": ">=22.18"
  },
  "bin": {
    "remy": "release/remy.js"
  },
  "files": [
    "release"
  ],
  "scripts": {
    "bundle": "esbuild src/main.ts --bundle --platform=node --target=node22 --format=esm --conditions=@remy/source --external:ink --external:react --external:'react/*' --banner:js=\"import{createRequire as __remyRequire}from'node:module';const require=__remyRequire(import.meta.url);\" --outfile=release/remy.js --log-level=warning"
  },
  "dependencies": {
    "ink": "^8.0.0",
    "react": "^19.3.1"
  },
  "devDependencies": {
    "@remy/core": "workspace:*",
    "@remy/evals": "workspace:*",
    "@remy/mcp": "workspace:*",
    "@remy/models": "workspace:*",
    "@remy/store": "workspace:*",
    "@remy/tools": "workspace:*",
    "@types/react": "^19.3.0",
    "esbuild": "^0.28.2",
    "ink-testing-library": "^4.0.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
