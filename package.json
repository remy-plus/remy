{
  "name": "remy",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@12.15.0",
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "build": "tsc -b",
    "typecheck": "tsc -p tsconfig.check.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "biome check .",
    "format": "biome check --write .",
    "eval": "node --conditions=@remy/source packages/evals/src/cli.ts",
    "eval:replay": "node --conditions=@remy/source packages/evals/src/cli.ts --model reference --strict",
    "eval:compare": "node --conditions=@remy/source packages/evals/src/cli.ts compare",
    "check": "pnpm lint && pnpm typecheck && pnpm build && pnpm test"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.3",
    "@remy/core": "workspace:*",
    "@remy/evals": "workspace:*",
    "@remy/models": "workspace:*",
    "@remy/store": "workspace:*",
    "@remy/tools": "workspace:*",
    "@types/node": "22.20.5",
    "typescript": "7.0.2",
    "vitest": "5.0.5",
    "zod": "^4.6.7"
  }
}
